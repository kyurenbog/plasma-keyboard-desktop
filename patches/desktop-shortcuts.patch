+
+static QList<QPair<int, Qt::KeyboardModifiers>> desktopQueue;
+static DesktopFakeInput *desktopFake = nullptr;
+
+static void desktopSendNext() {
+    if (desktopQueue.isEmpty()) return;
+    auto [code, mods] = desktopQueue.front();
+    QList<int> modifiers;
+    if (mods.testFlag(Qt::ControlModifier)) modifiers << KEY_LEFTCTRL;
+    if (mods.testFlag(Qt::AltModifier)) modifiers << KEY_LEFTALT;
+    if (mods.testFlag(Qt::MetaModifier)) modifiers << KEY_LEFTMETA;
+    if (mods.testFlag(Qt::ShiftModifier)) modifiers << KEY_LEFTSHIFT;
+    for (int modifier : modifiers) desktopFake->keyboard_key(modifier, 1);
+    desktopFake->keyboard_key(code, 1);
+    desktopFake->keyboard_key(code, 0);
+    QTimer::singleShot(20, desktopFake, [modifiers] {
+        for (auto it = modifiers.crbegin(); it != modifiers.crend(); ++it) desktopFake->keyboard_key(*it, 0);
+        desktopQueue.removeFirst();
+        if (!desktopQueue.isEmpty()) QTimer::singleShot(5, desktopFake, desktopSendNext);
+    });
+}
+
+static bool desktopKey(QKeyEvent *event, bool pressed) {
+    const auto mods = event->modifiers();
+    const bool shortcut = mods.testFlag(Qt::ControlModifier) || mods.testFlag(Qt::AltModifier) || mods.testFlag(Qt::MetaModifier);
+    const bool special = event->text().isEmpty() || event->key() >= Qt::Key_Escape;
+    if (!shortcut && !special) return false;
+    int code = desktopScanCode(event->key());
+    if (code < 0) return false;
+    if (!desktopFake) desktopFake = new DesktopFakeInput();
+    if (!desktopFake->isActive()) return false;
+    if (pressed) {
+        desktopQueue.append({code, mods});
+        if (desktopQueue.size() == 1) desktopSendNext();
+    }
+    event->accept();
+    return true;
+}
